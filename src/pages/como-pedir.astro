---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Proceso from '../components/Proceso.astro';
import Faq from '../components/Faq.astro';
import Formulario from '../components/Formulario.astro';
import Icono from '../components/Icono.astro';
import { FAQ_COMPLETA } from '../data/faq';
import { faqPage } from '../lib/schema';
import { enlaceWhatsApp, MENSAJES_WHATSAPP, NEGOCIO } from '../data/sitio';

const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Cómo pedir', href: '/como-pedir/' },
];

const DATOS = [
  {
    titulo: 'Nombre completo',
    texto: 'Tal como quiere que aparezca grabado. Si lleva un apodo o un «Don», dígannoslo.',
  },
  {
    titulo: 'Las dos fechas',
    texto: 'Nacimiento y fallecimiento. Las grabamos en número o con el mes escrito, como prefiera.',
  },
  {
    titulo: 'Frase o versículo',
    texto: 'San Juan 11:25, el Salmo 23, Filipenses 1:21, Gálatas 2:20 o la dedicatoria de la familia.',
  },
  {
    titulo: 'Fotografía (opcional)',
    texto: 'Si quiere medallón, mándela por WhatsApp desde la galería del teléfono, sin recortar.',
  },
  {
    titulo: 'Medida del espacio',
    texto: 'Si la sabe. Si no, una foto de la lápida con una cinta métrica apoyada nos basta.',
  },
  {
    titulo: 'Iconografía',
    texto: 'Paloma, ángel, manos orando, cruz, rosas, bordes ornamentales… o lo que tenga en mente.',
  },
];
---

<Base
  titulo="Cómo Pedir su Placa para Lápida | Arte y Recuerdo"
  descripcion="Qué datos necesitamos, cómo se aprueba el diseño y cuánto tarda una placa para lápida en Tegucigalpa. Resolvemos sus dudas por WhatsApp al 9751-3752."
  og="/og/como-pedir.jpg"
  migas={migas}
  schema={[faqPage(FAQ_COMPLETA)]}
>
  <section class="cab marmol">
    <div class="contenedor cab-int">
      <Migas migas={migas} />
      <h1 class="titulo entra" style="--d:100ms">Cómo pedir su placa</h1>
      <hr class="filete entra-filete cab-filete" style="--d:300ms" />
      <p class="entrada entra" style="--d:380ms">
        No hace falta que venga al taller ni que traiga nada escrito. Con un mensaje de WhatsApp
        empezamos, y usted aprueba el diseño antes de que toquemos el mármol.
      </p>
      <div class="acciones entra" style="--d:500ms">
        <a class="btn" href={enlaceWhatsApp(MENSAJES_WHATSAPP.general)} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" tamano={17} /> Empezar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <Proceso titulo="Los cinco pasos" />

  <section class="seccion claro" aria-labelledby="datos-tit">
    <div class="contenedor">
      <p class="etiqueta rev">Lo que necesitamos de usted</p>
      <h2 class="titulo rev" id="datos-tit" style="--i:1">Seis datos y ya podemos diseñar</h2>
      <hr class="filete rev-filete sep" style="--i:2" />
      <ul class="datos">
        {
          DATOS.map((d, i) => (
            <li class="rev" style={`--i:${i % 3}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </li>
          ))
        }
      </ul>
      <p class="nota rev">
        Si le falta alguno, escríbanos igual. Muchas familias llegan sin saber la fecha exacta o sin
        haber escogido el versículo, y lo vamos resolviendo juntos.
      </p>
    </div>
  </section>

  <section class="seccion aprob" aria-labelledby="aprob-tit">
    <div class="contenedor aprob-int">
      <div>
        <p class="etiqueta rev">Antes de fabricar</p>
        <h2 class="subtitulo rev" style="--i:1">Usted ve la placa antes de que exista</h2>
        <hr class="filete rev-filete sep-sm" style="--i:2" />
        <p class="rev" style="--i:3">
          Le mandamos el diseño por WhatsApp con todo en su lugar: el nombre tal como irá grabado,
          las fechas, el versículo, la iconografía y, si lleva, la fotografía ya montada. Usted lo
          revisa con calma y en familia.
        </p>
        <p class="rev" style="--i:4">
          Si quiere cambiar la letra, mover un elemento, corregir una fecha o probar el grabado en
          plateado en vez de dorado, se cambia y le mandamos la nueva versión. Eso no tiene costo y
          no hay límite de revisiones: preferimos repetir el diseño diez veces antes que entregar
          una placa con un error.
        </p>
        <p class="rev destacado" style="--i:5">
          Solo cuando usted dice que sí, se corta el mármol.
        </p>
      </div>
      <div class="lista-chk">
        <h3 class="rev">Revise con cuidado</h3>
        <ul>
          <li class="rev" style="--i:1">La ortografía del nombre y los apellidos.</li>
          <li class="rev" style="--i:2">Que las dos fechas sean las correctas.</li>
          <li class="rev" style="--i:3">La cita del versículo (libro, capítulo y versículo).</li>
          <li class="rev" style="--i:4">Los nombres de quienes firman la dedicatoria.</li>
          <li class="rev" style="--i:5">Que la fotografía sea la que la familia escogió.</li>
        </ul>
      </div>
    </div>
  </section>

  <Faq preguntas={FAQ_COMPLETA} titulo="Preguntas frecuentes" etiqueta="Todas sus dudas" id="faq" />

  <section class="seccion-sm visita">
    <div class="contenedor visita-int">
      <p class="rev">
        <Icono nombre="reloj" tamano={18} />
        <span>
          Atendemos de {NEGOCIO.horario[0].dias.toLowerCase()} de {NEGOCIO.horario[0].horas}, y el{' '}
          {NEGOCIO.horario[1].dias.toLowerCase()} de {NEGOCIO.horario[1].horas}.
        </span>
      </p>
      <a class="enlace rev" style="--i:1" href="/contacto/">
        Ver dónde estamos <Icono nombre="flecha" tamano={15} />
      </a>
    </div>
  </section>

  <Formulario />
</Base>

<style>
  .cab {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--borde);
  }
  .cab-int {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }
  .cab h1 {
    margin-top: 1.4rem;
  }
  .cab-filete {
    width: min(100%, 12rem);
    margin-block: 1.5rem 1.4rem;
  }
  .cab .acciones {
    margin-top: 1.8rem;
  }

  .sep {
    margin-block: 1.6rem 3rem;
    max-width: 10rem;
  }
  .sep-sm {
    margin-block: 1.3rem;
    max-width: 8rem;
  }

  .datos {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2rem 2.5rem;
  }
  .datos li {
    position: relative;
    padding-top: 1.3rem;
    border-top: 1px solid color-mix(in srgb, var(--txt-claro) 14%, transparent);
  }
  .num {
    position: absolute;
    top: 1.2rem;
    right: 0;
    font-family: var(--serif);
    color: var(--oro-oscuro);
  }
  .datos h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .datos p {
    font-size: 0.9375rem;
    color: var(--txt-claro-2);
    max-width: 32ch;
  }
  .nota {
    margin-top: 3rem;
    max-width: 52ch;
    color: var(--txt-claro-2);
  }
  @media (min-width: 42rem) {
    .datos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 66rem) {
    .datos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .aprob {
    border-top: 1px solid var(--borde);
  }
  .aprob-int {
    display: grid;
    gap: 2.5rem;
  }
  .aprob p {
    color: var(--txt-2);
    max-width: 50ch;
  }
  .aprob p + p {
    margin-top: 1rem;
  }
  .destacado {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--oro-claro);
    margin-top: 1.8rem !important;
  }
  .lista-chk {
    border: 1px solid var(--borde);
    background: var(--negro-2);
    padding: 1.8rem;
    align-self: start;
  }
  .lista-chk h3 {
    font-family: var(--sans);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--oro-texto);
    margin-bottom: 1.2rem;
  }
  .lista-chk ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .lista-chk li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    color: var(--txt-2);
  }
  .lista-chk li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 9px;
    height: 5px;
    border-left: 1.5px solid var(--oro);
    border-bottom: 1.5px solid var(--oro);
    transform: rotate(-45deg);
  }
  @media (min-width: 62rem) {
    .aprob-int {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
  }

  .visita {
    border-top: 1px solid var(--borde);
    background: var(--negro-2);
  }
  .visita-int {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .visita p {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--txt-2);
  }
  .visita :global(svg) {
    color: var(--oro);
  }
</style>
