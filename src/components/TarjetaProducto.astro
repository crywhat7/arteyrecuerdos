---
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import Marcador from './Marcador.astro';
import type { Producto } from '../data/productos';

interface Props {
  producto: Producto;
  indice?: number;
}
const { producto, indice = 0 } = Astro.props;
---

<article class="tarjeta rev" style={`--i:${indice}`}>
  <a href={producto.href} class="tarjeta-enlace">
    <div class="tarjeta-img">
      {
        producto.imagen ? (
          <Picture
            src={producto.imagen}
            alt={producto.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 90vw"
            formats={['avif']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Marcador icono={producto.icono} texto={producto.nombre} />
        )
      }
    </div>
    <div class="tarjeta-txt">
      <h3>{producto.nombre}</h3>
      <p>{producto.resumen}</p>
      <span class="ver">
        Ver <Icono nombre="flecha" tamano={15} />
      </span>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    border: 1px solid var(--borde);
    background: var(--negro-2);
    transition:
      border-color 0.5s var(--quart),
      transform 0.6s var(--expo);
  }
  .tarjeta:hover {
    border-color: color-mix(in srgb, var(--oro) 45%, transparent);
    transform: translateY(-4px);
  }
  .tarjeta-enlace {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .tarjeta-img {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--negro);
  }
  .tarjeta-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--expo);
  }
  .tarjeta:hover .tarjeta-img :global(img) {
    transform: scale(1.04);
  }
  .tarjeta-img :global(.marcador) {
    border: 0;
    aspect-ratio: 4 / 3;
  }

  .tarjeta-txt {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.35rem 1.4rem 1.5rem;
    flex: 1;
  }
  .tarjeta-txt h3 {
    font-size: 1.5rem;
    color: var(--txt);
  }
  .tarjeta-txt p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--txt-3);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oro-texto);
  }
  .ver :global(svg) {
    transition: transform 0.5s var(--expo);
  }
  .tarjeta:hover .ver :global(svg) {
    transform: translateX(5px);
  }
</style>
