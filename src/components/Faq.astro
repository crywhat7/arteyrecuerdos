---
import type { Pregunta } from '../data/faq';

interface Props {
  preguntas: Pregunta[];
  titulo?: string;
  etiqueta?: string;
  id?: string;
  class?: string;
}
const {
  preguntas,
  titulo = 'Preguntas frecuentes',
  etiqueta = 'Dudas comunes',
  id = 'faq',
  class: clase = '',
} = Astro.props;
---

<section class={`seccion faq ${clase}`} id={id} aria-labelledby={`${id}-tit`}>
  <div class="contenedor faq-int">
    <div class="faq-cab">
      <p class="etiqueta rev">{etiqueta}</p>
      <h2 class="titulo rev" id={`${id}-tit`} style="--i:1">{titulo}</h2>
      <hr class="filete rev-filete faq-filete" style="--i:2" />
    </div>

    <div class="faq-lista">
      {
        preguntas.map((p, i) => (
          <details class="item rev" style={`--i:${i}`} name={id}>
            <summary>
              <span>{p.pregunta}</span>
              <span class="mas" aria-hidden="true" />
            </summary>
            <div class="resp">
              <p>{p.respuesta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-int {
    display: grid;
    gap: 2.5rem;
  }
  .faq-filete {
    margin-top: 1.5rem;
    max-width: 10rem;
  }

  .item {
    border-top: 1px solid var(--borde);
  }
  .item:last-child {
    border-bottom: 1px solid var(--borde);
  }
  .claro .item {
    border-top-color: color-mix(in srgb, var(--txt-claro) 14%, transparent);
  }
  .claro .item:last-child {
    border-bottom-color: color-mix(in srgb, var(--txt-claro) 14%, transparent);
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.2rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.012em;
    transition: color 0.35s var(--quart);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--oro-claro);
  }
  .claro summary:hover {
    color: var(--oro-oscuro);
  }

  .mas {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 0.45rem;
  }
  .mas::before,
  .mas::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--oro);
    transition: transform 0.45s var(--expo);
  }
  .mas::after {
    transform: rotate(90deg);
  }
  .item[open] .mas::after {
    transform: rotate(0deg);
  }

  .resp {
    padding-bottom: 1.4rem;
    max-width: 58ch;
    color: var(--txt-2);
    animation: aparece 0.5s var(--quart) both;
  }
  .claro .resp {
    color: var(--txt-claro-2);
  }

  @media (min-width: 62rem) {
    .faq-int {
      grid-template-columns: 1fr 1.5fr;
      gap: 4rem;
    }
    .faq-cab {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
</style>
